# Copy to .env for local dev. In Netlify, set this as a site environment
# variable instead. There is no API-key env var anymore -- the frontend
# authenticates via real OAuth2 client credentials, entered at runtime on
# the "Connect as a Broker" screen (see ConnectPage.jsx), not baked in at
# build time.
VITE_API_BASE_URL=http://localhost:8080
